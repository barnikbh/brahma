# Brahma local configuration. Copy to `.env` (git-ignored) and fill in locally.
# Never commit real values: this file must keep every value empty.

# Model provider: meta, claude, llama_hosted or recorded (recorded needs no key).
BRAHMA_MODEL_PROVIDER=
# Model name for the chosen provider (not needed for recorded).
BRAHMA_MODEL_NAME=
# Meta Model API key (provider meta).
META_API_KEY=
# Anthropic API key (provider claude; building and drafting only).
ANTHROPIC_API_KEY=
# Free hosted Llama key, for example Groq or OpenRouter (provider llama_hosted).
LLAMA_API_KEY=
# Optional HTTPS base URL; empty uses the provider default.
BRAHMA_MODEL_BASE_URL=
# Optional requests per minute (1-1000); empty means 30.
BRAHMA_MODEL_RPM=
# Optional per-call timeout in seconds (5-120); empty means 45.
BRAHMA_MODEL_TIMEOUT_S=
# Optional SQLite file; empty means ./data/brahma.db.
BRAHMA_DB_PATH=
# Optional hours between background source checks (0-744); empty means 24, 0 turns it off.
BRAHMA_SOURCE_CHECK_HOURS=

# Backend server (u4). Secret that signs the session cookie; any long random string.
# With the recorded provider an empty value means a random secret per start.
BRAHMA_SESSION_SECRET=
# Optional comma-separated feature modules to mount; empty means brahma.updates.api.
BRAHMA_FEATURE_MODULES=
# Optional walk log file (JSON lines, no clinical text); empty means ./data/brahma.log.
BRAHMA_LOG_PATH=
# Optional bind address and port; empty means 127.0.0.1 and 8000.
BRAHMA_HOST=
BRAHMA_PORT=
# Optional fixture folder for the recorded provider; the local browser smoke test sets it
# to tests/agent/fixtures/recorded/demo. Empty uses the built-in default.
BRAHMA_RECORDED_DIR=
